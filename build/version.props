<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Centralized version management for SimpleModelServer projects -->

  <PropertyGroup>
    <!-- Semantic Versioning -->
    <VersionMajor>1</VersionMajor>
    <VersionMinor>0</VersionMinor>
    <VersionPatch>0</VersionPatch>
    <VersionPrerelease></VersionPrerelease>

    <!-- Composite version string -->
    <Version>$(VersionMajor).$(VersionMinor).$(VersionPatch)</Version>
    <AssemblyVersion>$(VersionMajor).$(VersionMinor).0.0</AssemblyVersion>
    <FileVersion>$(VersionMajor).$(VersionMinor).$(VersionPatch).0</FileVersion>

    <!-- Additional metadata -->
    <Company>SimpleModelServer Contributors</Company>
    <Product>SimpleModelServer</Product>
    <Authors>rsperry79</Authors>
    <Description>VS Code/Visual Studio extension for SimpleModelServer integration</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/rsperry79/SimpleModelServer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Build number from CI (override via environment variable or command line) -->
    <BuildNumber Condition="'$(BUILD_NUMBER)' != ''">$(BUILD_NUMBER)</BuildNumber>
    <BuildNumber Condition="'$(BuildNumber)' == ''">0</BuildNumber>

    <!-- Full semantic version including pre-release and build -->
    <SemanticVersion Condition="'$(VersionPrerelease)' == ''">$(Version)</SemanticVersion>
    <SemanticVersion Condition="'$(VersionPrerelease)' != ''">$(Version)-$(VersionPrerelease)</SemanticVersion>
  </PropertyGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!-- Import centralized version properties -->
  <Import Project="..\..\..\build\version.props" />

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <UseWPF>true</UseWPF>

    <!-- Library metadata -->
    <AssemblyName>SimpleModelServer.UI</AssemblyName>
    <RootNamespace>SimpleModelServer.UI</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Assembly Versioning from centralized version.props -->
    <AssemblyVersion>$(AssemblyVersion)</AssemblyVersion>
    <FileVersion>$(FileVersion)</FileVersion>
    <InformationalVersion>$(SemanticVersion)</InformationalVersion>

    <!-- Output and Intermediate paths -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>


  <ItemGroup>
    <!-- Microsoft Extensions for DI/Logging -->
    <PackageReference Include="Microsoft.CodeAnalysis" Version="5.6.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
  </ItemGroup>
</Project>

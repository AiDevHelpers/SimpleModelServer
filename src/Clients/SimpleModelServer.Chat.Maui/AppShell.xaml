<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SimpleModelServer.Chat.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SimpleModelServer.Chat.Maui"
    xmlns:pages="clr-namespace:SimpleModelServer.Chat.Maui.Pages"
    Title="SimpleModelServer.Chat.Maui">

    <FlyoutItem Title="Chat">
        <ShellContent
            Title="Chat"
            ContentTemplate="{DataTemplate pages:ChatPage}"
            Route="ChatPage" />
    </FlyoutItem>

    <MenuItem Text="Restart Server" Clicked="OnRestartServerClicked" />

    <MenuItem Text="Settings" Clicked="OnSettingsClicked" />

</Shell>

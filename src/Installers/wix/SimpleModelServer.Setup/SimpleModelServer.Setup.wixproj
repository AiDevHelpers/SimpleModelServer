<Project Sdk="WixToolset.Sdk/6.0.0" InitialTargets="ResolveMyAppVersionFromNbgv;PublishSimpleModelServerLoader;BuildVsExtensionVsix;PackVsCodeExtensionVsix;PublishChatMauiApp">
  <!--
    SimpleModelServer.Loader Windows installer (WiX v6, SDK-style project).

    Sibling of build/wix/TokenSaver.Setup — same structure, adapted for SimpleModelServer.Loader's
    extra requirements (config file that must survive upgrades, a netsh URL ACL for the
    router's HttpListener, and sc.exe failure-action backoff). See
    SimpleModelServer/SimpleModelServer.Loader/INSTALLER_REQUIREMENTS.md for the full behavioral spec this
    project must satisfy, and build/scripts/install-draftmodel-service.ps1 for the reference
    implementation this MSI reproduces.

    This MSI installs SimpleModelServer.Loader as the "SimpleModelServerLoader" Windows service (router on
    port 11435 by default). It does NOT replace install-draftmodel-service.ps1 — that script
    remains a fully supported install path (and is still what -RunInstaller in
    SimpleModelServer.Loader.csproj invokes) — this project is an alternative MSI-based packaging of
    the same behavior, matching how TokenSaver.Setup was added as an alternative to its old
    Inno Setup script.

    Versioning: same NBGV caveat as TokenSaver.Setup (NBGV is incompatible with WiX
    Bundle/Package project types). build\scripts\publish-draftmodel-for-wix.ps1 resolves the
    version via `nbgv get-version` and passes it in explicitly:
      dotnet build build\wix\SimpleModelServer.Setup\SimpleModelServer.Setup.wixproj -p:MyAppVersion=1.0.0

    If -p:MyAppVersion is not supplied, MyAppVersion falls back to the literal default below so
    the solution still builds standalone. See docs/versioning.md.

    Prerequisite: a self-contained build of SimpleModelServer.Loader must exist at
    build\staging\SimpleModelServer.Loader\$(Configuration) (see PublishDir property below). The
    PublishSimpleModelServerLoader target below (BeforeTargets="Build") handles this automatically for
    `dotnet build TokenSaver.slnx` and Visual Studio "Build Solution" — it runs `dotnet
    publish` on SimpleModelServer.Loader.csproj only when the staged exe is missing or older than the
    source project, so incremental builds don't republish every time. For a full release build
    with an explicit version and clearer step-by-step console output, prefer
    build\scripts\publish-draftmodel-for-wix.ps1 -Pack instead.

    WixProjDir / RepoRoot: WiX preprocessor variables (not MSBuild macros) used by Product.wxs
    for File/Source paths outside PublishDir (AI_INSTRUCTIONS_REMOTE_ROUTER.md,
    install-support.ps1). $(MSBuildThisFileDirectory) is an MSBuild-only macro and is NOT
    resolvable inside a .wxs file's own preprocessor — using it directly in a .wxs Source
    attribute fails with WIX0150 "Undefined preprocessor variable". Any path a .wxs file needs
    must be threaded through here as a DefineConstants entry first, same as PublishDir already
    was.
  -->
  <PropertyGroup>
    <!-- Captured BEFORE the literal-fallback defaults below are applied, so
         ResolveMyAppVersionFromNbgv (an InitialTarget, which runs after this PropertyGroup is
         already evaluated) can still tell "caller passed -p:MyAppVersion explicitly" apart from
         "nothing passed, use the literal fallback". See TokenSaver.Setup.wixproj (sibling
         project) for the same pattern and the full rationale — this project had the identical
         bug: any build that skipped build\scripts\publish-draftmodel-for-wix.ps1 fell back to a
         hardcoded 1.0.0 every time, so MajorUpgrade never saw a version increase and each build
         installed as a brand-new product instead of upgrading (hence multiple "SimpleModelServer
         Loader" entries in Programs & Features, all at 1.0.0). -->
    <_MyAppVersionWasUnset Condition="'$(MyAppVersion)' == ''">true</_MyAppVersionWasUnset>
    <MyAppVersion Condition="'$(MyAppVersion)' == ''">1.0.0</MyAppVersion>
    <GitCommitHash Condition="'$(GitCommitHash)' == ''">unknown</GitCommitHash>
    <Platform>x64</Platform>
    <OutputType>Package</OutputType>
    <OutputName>SimpleModelServer-Setup-$(MyAppVersion)</OutputName>
    <OutputPath>..\..\..\..\build\dist\$(Configuration.ToLower())\</OutputPath>
    <DefineConstants>
      MyAppVersion=$(MyAppVersion);
      GitCommitHash=$(GitCommitHash);
      PublishDir=$(MSBuildThisFileDirectory)..\..\..\..\build\staging\SimpleModelServer.Loader\$(Configuration);
      WixProjDir=$(MSBuildThisFileDirectory);
      RepoRoot=$(MSBuildThisFileDirectory)..\..\..\..\..\;
      VsExtensionVsix=$(MSBuildThisFileDirectory)..\..\..\Extensions\SimpleModelServer.Extensions.VS\bin\$(Configuration)\SimpleModelServer.Extensions.VS.vsix;
      VsCodeExtensionVsix=$(MSBuildThisFileDirectory)..\..\..\..\build\staging\SimpleModelServer.Extensions.VSCode\simplemodelserver-vscode.vsix;
      ChatMauiPublishDir=$(MSBuildThisFileDirectory)..\..\..\..\build\staging\SimpleModelServer.Chat.Maui\$(Configuration)
    </DefineConstants>
    <SuppressPdbOutput>true</SuppressPdbOutput>
    <!-- ICE03/ICE60 fire on the ChatAppFeature payload only: a self-contained MAUI/WinUI
         publish wildcard-harvests hundreds of native/managed DLLs (WindowsAppSDK, ucrtbase,
         etc.) that carry unusual or absent PE resource-language IDs. This is a well-known
         false-positive against real-world .NET publish output, not a defect in these files —
         SimpleModelServerFiles (the main service payload) never triggered it because it's a
         much smaller, framework-dependent set. Suppressing both ICEs project-wide rather than
         per-file since the offending files are wildcard-harvested and not individually listed. -->
    <SuppressIces>ICE03;ICE60</SuppressIces>
  </PropertyGroup>
  <PropertyGroup>
    <SimpleModelServerLoaderCsproj>$(MSBuildThisFileDirectory)..\..\..\..\src\Server\SimpleModelServer.Server\SimpleModelServer.Server.csproj</SimpleModelServerLoaderCsproj>
    <SimpleModelServerLoaderStagedExe>$(MSBuildThisFileDirectory)..\..\..\..\build\staging\SimpleModelServer.Loader\$(Configuration)\SimpleModelServer.Server.exe</SimpleModelServerLoaderStagedExe>
    <VsExtensionCsproj>$(MSBuildThisFileDirectory)..\..\..\Extensions\SimpleModelServer.Extensions.VS\SimpleModelServer.Extensions.VS.csproj</VsExtensionCsproj>
    <VsCodeExtensionDir>$(MSBuildThisFileDirectory)..\..\..\Extensions\SimpleModelServer.Extensions.VSCode\</VsCodeExtensionDir>
    <ChatMauiCsproj>$(MSBuildThisFileDirectory)..\..\..\Clients\SimpleModelServer.Chat.Maui\SimpleModelServer.Chat.Maui.csproj</ChatMauiCsproj>
    <ChatMauiStagedDir>$(MSBuildThisFileDirectory)..\..\..\..\build\staging\SimpleModelServer.Chat.Maui\$(Configuration)</ChatMauiStagedDir>
    <ChatMauiStagedExe>$(ChatMauiStagedDir)\SimpleModelServer.Chat.Maui.exe</ChatMauiStagedExe>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis" Version="5.6.0" />
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.0" />
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.0" />
  </ItemGroup>
  <!-- WixToolset.Sdk auto-globs *.wxs in the project directory — Product.wxs and Service.wxs
       are picked up automatically. An explicit <Compile Include> here would double-include
       both files, tripping WIX0089/WIX0090 "multiple entry sections" since Product.wxs's
       <Package> would compile twice. -->
  <!-- Inputs glob for PublishSimpleModelServerLoader's up-to-date check, below. SimpleModelServer.Loader.csproj
       transitively references SimpleModelServer.Config and SimpleModelServer.Library — both siblings under
       SimpleModelServer\ — see its ProjectReference list. This supplements (not replaces)
       SimpleModelServerLoaderCsproj as an Inputs entry so an edit to any file the publish actually
       depends on invalidates the staged exe, not just an edit to SimpleModelServer.Loader.csproj's own
       file.

       IMPORTANT: SimpleModelServerLoaderCsproj is always listed first/unconditionally in Inputs below
       — MSBuild treats a target's Inputs/Outputs as "nothing to do, skip entirely" whenever
       Inputs resolves to zero items, even if Outputs is missing. A recursive wildcard glob can
       legitimately evaluate to zero items in edge cases (SDK default-exclude interactions,
       an as-yet-uncreated obj/ dir, a locked file mid-build, etc.), which would silently skip
       this target and produce WIX0103 ("Cannot find the File/Icon file ...") even on a clean
       build. Keeping SimpleModelServerLoaderCsproj as a guaranteed-non-empty Input means the target
       always has at least one item to evaluate staleness against. -->
  <ItemGroup>
    <_SimpleModelServerLoaderPublishInputs Include="$(MSBuildThisFileDirectory)..\..\..\**\*.cs" Exclude="$(MSBuildThisFileDirectory)..\..\..\**\bin\**;$(MSBuildThisFileDirectory)..\..\..\**\obj\**;$(MSBuildThisFileDirectory)..\..\..\build\**" />
    <_SimpleModelServerLoaderPublishInputs Include="$(MSBuildThisFileDirectory)..\..\..\**\*.csproj" Exclude="$(MSBuildThisFileDirectory)..\..\..\build\**" />
  </ItemGroup>
  <!-- Auto-publish SimpleModelServer.Loader into build\staging\SimpleModelServer.Loader\$(Configuration) before this project
       builds, so `dotnet build TokenSaver.slnx` and Visual Studio "Build Solution" don't
       fail on WIX0103 (missing Icon/File) just because the manual publish script wasn't run
       first, or because the staged exe is missing (e.g. after a clean or a fresh clone).
       Inputs/Outputs makes this incremental: skipped only when the staged exe already exists
       AND is newer than SimpleModelServerLoaderCsproj and everything in _SimpleModelServerLoaderPublishInputs
       — re-run the publish script manually for a guaranteed-fresh package if you ever suspect
       this heuristic missed something (e.g. a generated file, or a dependency outside this
       tree).

       This target is wired up via the project's InitialTargets="PublishSimpleModelServerLoader"
       attribute (see the <Project> element at the top of this file), NOT BeforeTargets="Build".
       BeforeTargets="Build;Rebuild;CoreBuild" was tried first and did not reliably run under
       Visual Studio's IDE build ("Build Solution" / F5) — WIX0103 kept firing with the staged
       exe missing even after a full solution reload, meaning VS's build for a WixToolset.Sdk
       project doesn't necessarily invoke a target named "Build"/"Rebuild"/"CoreBuild" as its
       entry point the way `dotnet build`/MSBuild.exe do, so a BeforeTargets hook on those names
       can be silently skipped. InitialTargets is not optional or dependent on which target ends
       up being the entry point — MSBuild runs every target listed in InitialTargets before
       ANYTHING else in the project, unconditionally, regardless of build tool or IDE. This is
       the guaranteed fix; keep this target wired via InitialTargets, not BeforeTargets, unless
       a future WiX SDK version documents a supported alternative.

       The trailing Error task is a hard guard: if the Exec "succeeds" (exit 0) but the exe
       still isn't where WiX expects it, fail loudly here with an actionable message instead
       of letting the build limp forward into a confusing WIX0103 deep inside .wxs
       compilation. -->
  <!-- Sibling of TokenSaver.Setup.wixproj's ResolveMyAppVersionFromNbgv target — same fix,
       same reasoning. Resolves MyAppVersion/GitCommitHash via `dotnet nbgv` for EVERY build
       path (plain `dotnet build`, VS "Build Solution", and the publish script), using `nbgv` as
       a local tool restored from .config\dotnet-tools.json (added alongside this fix — this
       project had no tool manifest before). Skipped entirely if the caller already passed
       -p:MyAppVersion explicitly.

       SimpleVersion is Major.Minor.Height (e.g. 1.0.42), a real monotonically-increasing
       version per commit — required for MajorUpgrade to reliably tell "newer" from
       "same"/"older" across builds. GitCommitIdShort is stamped into ARPCOMMENTS (see
       Product.wxs) purely for build traceability; it plays no role in upgrade detection (MSI
       version fields are numeric only).

       Falls back to the MyAppVersion/GitCommitHash literals above (not a build error) if nbgv
       can't resolve a version (shallow clone, blocked tool restore), so this project still
       builds standalone. -->
  <Target Name="ResolveMyAppVersionFromNbgv" Condition="'$(_MyAppVersionWasUnset)' == 'true'">
    <Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildThisFileDirectory)..\..\..\" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" />
    <Exec Command="dotnet nbgv get-version -v SimpleVersion" WorkingDirectory="$(MSBuildThisFileDirectory)..\..\..\" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="_NbgvSimpleVersionLines" />
      <Output TaskParameter="ExitCode" PropertyName="_NbgvSimpleVersionExitCode" />
    </Exec>
    <Exec Command="dotnet nbgv get-version -v GitCommitIdShort" WorkingDirectory="$(MSBuildThisFileDirectory)..\..\..\" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="_NbgvGitHashLines" />
      <Output TaskParameter="ExitCode" PropertyName="_NbgvGitHashExitCode" />
    </Exec>
    <PropertyGroup Condition="'$(_NbgvSimpleVersionExitCode)' == '0' AND '@(_NbgvSimpleVersionLines)' != ''">
      <MyAppVersion>@(_NbgvSimpleVersionLines)</MyAppVersion>
    </PropertyGroup>
    <PropertyGroup Condition="'$(_NbgvGitHashExitCode)' == '0' AND '@(_NbgvGitHashLines)' != ''">
      <GitCommitHash>@(_NbgvGitHashLines)</GitCommitHash>
    </PropertyGroup>
    <Message Importance="high" Text="SimpleModelServer.Setup: MyAppVersion=$(MyAppVersion) GitCommitHash=$(GitCommitHash)" />
  </Target>
  <Target Name="PublishSimpleModelServerLoader" Inputs="$(SimpleModelServerLoaderCsproj);@(_SimpleModelServerLoaderPublishInputs)" Outputs="$(SimpleModelServerLoaderStagedExe)">
    <Message Importance="high" Text="SimpleModelServer.Setup: publishing SimpleModelServer.Loader to build\staging\SimpleModelServer.Loader\$(Configuration) ..." />
    <Exec Command="dotnet publish &quot;$(SimpleModelServerLoaderCsproj)&quot; --configuration $(Configuration) --runtime win-x64 --self-contained true --output &quot;$(MSBuildThisFileDirectory)..\..\..\..\build\staging\SimpleModelServer.Loader\$(Configuration)&quot;" />
    <Error Condition="!Exists('$(SimpleModelServerLoaderStagedExe)')" Text="PublishSimpleModelServerLoader ran but $(SimpleModelServerLoaderStagedExe) still doesn't exist. Run build\scripts\publish-draftmodel-for-wix.ps1 manually and check its output for the real dotnet publish failure." />
  </Target>
  <!-- Builds the VS extension's .vsix so it can be bundled as an optional MSI feature (see
       VsExtensionFeature in Product.wxs). GenerateVsixPackage is already enabled in
       SimpleModelServer.Extensions.VS.csproj, so a plain `dotnet build` in $(Configuration)
       produces the .vsix at the VsExtensionVsix path defined above — no separate packaging
       step needed, unlike the VS Code extension (which has no MSBuild-driven build). -->
  <Target Name="BuildVsExtensionVsix" Inputs="$(VsExtensionCsproj)" Outputs="$(VsExtensionVsix)">
    <Message Importance="high" Text="SimpleModelServer.Setup: building VS extension vsix ($(Configuration)) ..." />
    <Exec Command="dotnet build &quot;$(VsExtensionCsproj)&quot; --configuration $(Configuration)" />
    <Error Condition="!Exists('$(VsExtensionVsix)')" Text="BuildVsExtensionVsix ran but $(VsExtensionVsix) still doesn't exist. Build SimpleModelServer.Extensions.VS.csproj manually and check its output for the real failure." />
  </Target>
  <!-- Packages the VS Code extension's .vsix via `npm run package` (vsce), which this project's
       package.json defines to output straight to VsCodeExtensionVsix below (see that project's
       package.json "package" script and .vscodeignore). Requires Node/npm on PATH and
       `npm install` to have been run at least once in that directory — this target does not
       run `npm install` itself since node_modules is developer-machine state, not something
       every MSI build should touch. -->
  <Target Name="PackVsCodeExtensionVsix" Inputs="$(VsCodeExtensionDir)package.json;$(VsCodeExtensionDir)src\**\*.ts" Outputs="$(VsCodeExtensionVsix)">
    <Message Importance="high" Text="SimpleModelServer.Setup: packaging VS Code extension vsix ..." />
    <Exec Command="npm run package" WorkingDirectory="$(VsCodeExtensionDir)" />
    <Error Condition="!Exists('$(VsCodeExtensionVsix)')" Text="PackVsCodeExtensionVsix ran but $(VsCodeExtensionVsix) still doesn't exist. Run `npm install &amp;&amp; npm run package` manually in $(VsCodeExtensionDir) and check its output for the real failure." />
  </Target>
  <!-- Publishes the MAUI chat client as a self-contained, unpackaged win-x64 app for the
       optional ChatAppFeature (see Product.wxs). Same Inputs/Outputs incremental pattern as
       PublishSimpleModelServerLoader — mirrors the reasoning there for why this needs
       InitialTargets rather than BeforeTargets, and why a hard Exists() guard follows the Exec. -->
  <Target Name="PublishChatMauiApp" Inputs="$(ChatMauiCsproj)" Outputs="$(ChatMauiStagedExe)">
    <Message Importance="high" Text="SimpleModelServer.Setup: publishing SimpleModelServer.Chat.Maui to build\staging\SimpleModelServer.Chat.Maui\$(Configuration) ..." />
    <Exec Command="dotnet publish &quot;$(ChatMauiCsproj)&quot; -f net10.0-windows10.0.19041.0 --configuration $(Configuration) --runtime win-x64 --self-contained true --output &quot;$(ChatMauiStagedDir)&quot;" />
    <Error Condition="!Exists('$(ChatMauiStagedExe)')" Text="PublishChatMauiApp ran but $(ChatMauiStagedExe) still doesn't exist. Run `dotnet publish` on SimpleModelServer.Chat.Maui.csproj manually and check its output for the real failure." />
  </Target>
</Project>
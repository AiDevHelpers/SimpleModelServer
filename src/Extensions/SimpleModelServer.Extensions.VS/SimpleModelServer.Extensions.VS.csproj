<Project Sdk="Microsoft.NET.Sdk">
  <!-- Import centralized version properties -->
  <Import Project="..\..\..\build\version.props" />

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <UseWPF>true</UseWPF>

    <VssdkCompatibleExtension>true</VssdkCompatibleExtension>

    <!-- Extension metadata -->
    <ExtensionVersion>$(Version)</ExtensionVersion>
    <ExtensionAuthor>$(Company)</ExtensionAuthor>
    <ExtensionName>SimpleModelServer VS Extension</ExtensionName>
    <ExtensionCategory>Coding Tools</ExtensionCategory>

    <!-- VSIX Configuration -->
    <GenerateVsixPackage>true</GenerateVsixPackage>
    <GenerateVsixManifestFromManagedPackageManifest>true</GenerateVsixManifestFromManagedPackageManifest>
    <VsixPackageOutputPath>$(OutputPath)</VsixPackageOutputPath>
    <VsixLanguage>en-US</VsixLanguage>

    <!-- Assembly Versioning from centralized version.props -->
    <AssemblyVersion>$(AssemblyVersion)</AssemblyVersion>
    <FileVersion>$(FileVersion)</FileVersion>
    <InformationalVersion>$(SemanticVersion)</InformationalVersion>

    <!-- Output and Intermediate paths -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!-- Suppress package downgrade warnings and treat as warnings, not errors -->
    <WarningLevel>0</WarningLevel>

    <!-- Deterministic builds for reproducibility -->
    <Deterministic Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <!-- VisualStudio.Extensibility SDK (modern VS 2022+ extension framework) -->
    <PackageReference Include="Microsoft.CodeAnalysis" Version="5.9.0" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="17.14.40608" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Build" Version="17.14.40608" PrivateAssets="all" />

    <!-- Legacy VSSDK for compatibility and additional features -->
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.Shell.15.0" Version="17.14.40264" />

    <!-- Override MessagePack transitive dependency to patch known vulnerabilities -->
    <PackageReference Include="MessagePack" Version="3.1.12" />

    <!-- Extensions - Use SDK-compatible versions -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI Library reference for reusable settings panel and core services -->
    <ProjectReference Include="..\..\UI\SimpleModelServer.UI\SimpleModelServer.UI.csproj" />
    <!-- Discovery library for server connection management -->
    <ProjectReference Include="..\..\Common\SimpleModelServer.Discovery\SimpleModelServer.Discovery.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Resource references -->
    <Resource Include=".vsextension\string-resources.json" />
  </ItemGroup>
</Project>

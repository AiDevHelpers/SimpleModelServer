<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SimpleModelServer.Extensions.VS.UI.Chat.ChatToolWindowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="300">

    <Grid Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header with Status and Settings -->
        <Border Grid.Row="0" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Connection Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,5,0" Fill="Green" />
                    <TextBlock
                        Text="Connected"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </StackPanel>

                <!-- Agent Selector -->
                <TextBlock Grid.Column="1" Margin="20,0,5,0" Text="Agent:" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                <ComboBox
                    Grid.Column="2"
                    Margin="0,0,10,0"
                    SelectedItem="{Binding SelectedAgent}"
                    VerticalAlignment="Center" />

                <!-- Buttons -->
                <Button Grid.Column="3" Margin="5" Padding="8,4" ToolTip="Clear chat history" Click="ClearButtonClick">
                    <TextBlock Text="Clear" />
                </Button>
                <Button Grid.Column="4" Margin="5" Padding="8,4" ToolTip="Open settings" Click="SettingsButtonClick">
                    <TextBlock Text="⚙" />
                </Button>
            </Grid>
        </Border>

        <!-- Chat Messages Display -->
        <Border Grid.Row="1" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" Margin="10">
            <ScrollViewer>
                <TextBlock
                    x:Name="ChatDisplay"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                    Text="{Binding ResponseText}" />
            </ScrollViewer>
        </Border>

        <!-- Message Input Area -->
        <Border Grid.Row="2" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    Grid.Column="0"
                    x:Name="MessageInput"
                    Text="{Binding CurrentMessage}"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MaxHeight="80"
                    Margin="0,0,5,0"
                    Padding="5"
                    VerticalScrollBarVisibility="Auto"
                    Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                    KeyDown="MessageInput_KeyDown" />

                <Button
                    Grid.Column="1"
                    Margin="5,0"
                    Padding="10,5"
                    Click="SendButtonClick"
                    ToolTip="Send message (Ctrl+Enter)">
                    <TextBlock Text="Send" />
                </Button>

                <Button
                    Grid.Column="2"
                    Margin="5,0"
                    Padding="10,5"
                    Click="CancelButtonClick"
                    ToolTip="Cancel current request">
                    <TextBlock Text="Cancel" />
                </Button>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
            <TextBlock
                x:Name="StatusText"
                Margin="10"
                Text="Ready"
                Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                FontSize="10" />
        </Border>
    </Grid>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
</UserControl>

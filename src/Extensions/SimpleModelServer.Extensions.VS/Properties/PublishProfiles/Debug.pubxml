<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Debug Build Publish Profile for SimpleModelServer VS Extension -->

  <PropertyGroup>
    <!-- Build Configuration -->
    <Configuration>Debug</Configuration>
    <Platform>AnyCPU</Platform>
    <PlatformName>Any CPU</PlatformName>

    <!-- Output paths -->
    <OutputPath>bin\Debug\net472\</OutputPath>
    <IntermediateOutputPath>obj\Debug\</IntermediateOutputPath>
    <PublishDir>$(OutputPath)publish\</PublishDir>

    <!-- VSIX Generation Settings -->
    <GenerateVsixPackage>true</GenerateVsixPackage>
    <VsixPackageOutputPath>$(OutputPath)</VsixPackageOutputPath>
    <GenerateVsixManifestFromManagedPackageManifest>true</GenerateVsixManifestFromManagedPackageManifest>

    <!-- Version Info -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <ProductVersion>1.0.0-dev</ProductVersion>
    <InformationalVersion>1.0.0-dev</InformationalVersion>

    <!-- VSIX Metadata -->
    <VsixVersion>1.0.0</VsixVersion>
    <VsixID>SimpleModelServer.Extensions.VS.56c8b593-11c3-48bb-ba20-21e0a7226282</VsixID>
    <VsixLanguage>en-US</VsixLanguage>

    <!-- Compilation Options -->
    <DebugSymbols>true</DebugSymbols>
    <DebugType>embedded</DebugType>
    <Optimize>false</Optimize>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>

    <!-- Documentation -->
    <DocumentationFile>$(OutputPath)SimpleModelServer.Extensions.VS.xml</DocumentationFile>
    <GenerateDocumentation>true</GenerateDocumentation>

    <!-- Other Options -->
    <Deterministic>false</Deterministic>
    <ContinuousIntegrationBuild>false</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Label="Package Metadata">
    <PackageId>SimpleModelServer.VS.Extension</PackageId>
    <Title>SimpleModelServer IDE Integration (Debug)</Title>
    <Description>Visual Studio extension for seamless integration with SimpleModelServer. Features include interactive chat, code explanation, test generation, and optimization suggestions directly in the IDE. [DEBUG BUILD]</Description>
    <Authors>SimpleModelServer Contributors</Authors>
    <Owner>rsperry79</Owner>
    <LicenseExpression>MIT</LicenseExpression>
    <ProjectUrl>https://github.com/rsperry79/SimpleModelServer</ProjectUrl>
    <RepositoryUrl>https://github.com/rsperry79/SimpleModelServer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Tags>AI;ModelServer;Chat;CodeGeneration;Testing;Optimization;VisualStudio;Debug</Tags>
  </PropertyGroup>

  <!-- Build Targets for Debug VSIX Package -->
  <Target Name="PrintPublishInfo" BeforeTargets="Build">
    <Message Text="========================================" Importance="high" />
    <Message Text="SimpleModelServer VS Extension - Debug Build" Importance="high" />
    <Message Text="Configuration: $(Configuration)" Importance="high" />
    <Message Text="Platform: $(Platform)" Importance="high" />
    <Message Text="Output: $(OutputPath)" Importance="high" />
    <Message Text="VSIX Version: $(VsixVersion)" Importance="high" />
    <Message Text="========================================" Importance="high" />
  </Target>
</Project>

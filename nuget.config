<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for SimpleModelServer.

  SperryDev.Logger and TokenSaver.Common.* are published to the GitHub Packages feed (rsperry79).
  - CI: the workflow adds that feed with a read:packages token before restore, so nothing
    sensitive lives in this file.
  - Local development (wip): restore from the local feed, added once per machine:
      dotnet nuget add source <full path to ../Common/artifacts> with the name tokensaver-common-local
    SperryDev.Logger prerelease builds are packed into that folder. A local source that does not
    exist makes restore fail on machines that lack it, so it is added per machine, not listed here.
-->
<configuration>
  <packageSources>
    <!-- No <clear />: per-machine sources (tokensaver-common-local) must stay visible. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
